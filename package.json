{
  "name": "command-center",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "A Linux control deck for repositories, configuration, backup, and recovery.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "tauri build --no-bundle",
    "desktop:install": "npm run desktop:build && node scripts/install-desktop.mjs",
    "desktop:package": "tauri build --bundles deb,rpm",
    "desktop:update": "bash scripts/update-desktop.sh",
    "release:draft": "node scripts/release-draft.mjs",
    "toolbox:pin": "node scripts/pin-toolbox.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsonc-parser": "^3.3.1"
  }
}
